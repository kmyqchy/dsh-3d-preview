# Dev-only: `dsh-better-sidebar` is a devDependency used purely for its type
# declarations, and it pulls `node-pty`, whose native build fails in plenty of
# container images. Nothing in this plugin needs install scripts — `three`,
# `esbuild` and the model renderer all ship prebuilt — so skip them.
#
# This file never reaches consumers: npm/pnpm only read the .npmrc of the
# project being installed into, never a dependency's.
ignore-scripts=true
